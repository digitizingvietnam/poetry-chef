# Copy to .env and fill in your values.

# Required: OpenAI API key used for chat completions (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# Optional: OpenAI chat model used to re-cook emotions (default: gpt-4o-mini)
CHAT_MODEL=gpt-4o-mini

# Optional: folder containing data.csv (default: data)
DATA_DIR=data

# Optional: JSON list of origins allowed to call the API (default: ["*"]).
# The bundled frontend is served by FastAPI on the same origin, so this is only
# needed if another site calls the API directly.
# ALLOWED_ORIGINS=["https://example.com"]
